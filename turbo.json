{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Set by CI to the GitHub Pages project-site base path; it changes
      // the emitted asset URLs, so it has to be part of the cache key.
      "env": ["BASE_PATH"],
      "outputs": ["dist/**"]
    },
    "@sconote/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      // This package's source is the Rust workspace, not its own directory.
      // Without these inputs the cache key never changes when the DSP core
      // does, and a stale wasm is served forever.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/crates/**/*.rs",
        "$TURBO_ROOT$/crates/**/Cargo.toml",
        "$TURBO_ROOT$/crates/**/models/**"
      ]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
